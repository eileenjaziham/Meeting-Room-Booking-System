@import './styles/tokens.wxss';
page{background:var(--ui-background);color:var(--ui-text);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:30rpx;line-height:1.6}
view,button,input,textarea{box-sizing:border-box}
button{font-size:30rpx;font-weight:500;border-radius:var(--ui-radius-button);line-height:1.5;min-height:44px;padding:24rpx;margin:0;transition:opacity var(--ui-motion-fast),background-color var(--ui-motion-fast)}
button::after{border:0}button:active,.button-hover{opacity:.82}button[disabled]{opacity:1;background:var(--ui-disabled);color:var(--ui-disabled-text);box-shadow:none}
.page{padding:28rpx 26rpx 40rpx;padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}
.card{background:var(--ui-surface);border:1rpx solid var(--ui-border);border-radius:var(--ui-radius-card);padding:28rpx;margin-bottom:24rpx;box-shadow:var(--ui-shadow-card);min-width:0}
.title{font-size:var(--ui-font-title);font-weight:650;line-height:1.4;margin-bottom:14rpx;color:var(--ui-text)}.subtitle{font-size:var(--ui-font-heading);font-weight:600;line-height:1.45;margin-bottom:16rpx}.muted{color:var(--ui-text-muted);font-size:24rpx;line-height:1.7}.small{font-size:24rpx}
.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-width:0}.stack>view+view,.stack>button+button{margin-top:20rpx}
.primary{background:var(--ui-primary);color:#fff}.secondary{background:#eef2f4;color:var(--ui-primary)}.danger{background:var(--ui-danger-soft);color:var(--ui-danger)}.success{background:var(--ui-success-soft);color:var(--ui-success)}
.notice,.error{border-radius:16rpx;padding:20rpx 22rpx;font-size:26rpx;line-height:1.65;margin-bottom:24rpx;overflow-wrap:anywhere}.notice{background:var(--ui-warning-soft);color:var(--ui-warning)}.error{background:var(--ui-danger-soft);color:var(--ui-danger);border:1rpx solid #f3d6dc}.error .link{display:flex;align-items:center;min-height:44px;font-weight:500;margin-top:8rpx}
.empty{text-align:center;color:var(--ui-text-muted);padding:60rpx 20rpx;font-size:26rpx;line-height:1.7}.field{display:block;margin:26rpx 0}.label{display:block;font-size:26rpx;line-height:1.5;color:var(--ui-text);font-weight:500;margin-bottom:12rpx}
input,textarea,.picker{display:block;width:100%;background:var(--ui-field);color:var(--ui-text);border:1rpx solid var(--ui-border);border-radius:var(--ui-radius-control);padding:20rpx 22rpx;font-size:30rpx;min-height:44px;line-height:1.5}
input{height:96rpx}textarea{min-height:176rpx;height:200rpx}.field:focus-within input,.field:focus-within textarea,input:focus,textarea:focus{border-color:#a9b8bb;background:#fff;box-shadow:0 0 0 4rpx rgba(86,108,113,.1)}
.picker{min-height:96rpx;display:flex;align-items:center;overflow-wrap:anywhere}.link{color:var(--ui-primary)}.divider{height:1rpx;background:var(--ui-border);margin:24rpx 0}
.badge{display:inline-block;border-radius:9rpx;padding:4rpx 12rpx;font-size:24rpx;line-height:1.5;background:#eef2f4;color:var(--ui-primary);white-space:normal;overflow-wrap:anywhere}.badge.pending{background:var(--ui-warning-soft);color:var(--ui-warning)}.badge.approved{background:var(--ui-success-soft);color:var(--ui-success)}.badge.rejected{background:var(--ui-danger-soft);color:var(--ui-danger)}.badge.cancelled,.badge.expired,.badge.completed{background:var(--ui-neutral-soft);color:var(--ui-neutral)}
.filters{display:flex;gap:12rpx;flex-wrap:wrap;margin-bottom:24rpx}.chip{display:flex;align-items:center;justify-content:center;background:#fff;color:var(--ui-text-muted);border:1rpx solid var(--ui-border);border-radius:16rpx;padding:14rpx 20rpx;min-height:44px;font-size:25rpx;line-height:1.5}.chip.active{background:var(--ui-primary-soft);border-color:var(--ui-primary);color:var(--ui-primary);font-weight:500}
.actions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}.actions button{flex:1;min-width:120rpx}.kv{display:flex;justify-content:space-between;gap:24rpx;padding:16rpx 0;font-size:27rpx;line-height:1.65}.kv text:first-child{color:var(--ui-text-muted);flex-shrink:0}.kv text:last-child{text-align:right;min-width:0;overflow-wrap:anywhere;word-break:normal}.admin-title{color:var(--ui-success)}.bottom-space{height:32rpx}.tap-pressed{opacity:.72}.required{color:var(--ui-danger)}
@media(prefers-reduced-motion:reduce){button{transition:none}}
@media(max-width:350px){.page{padding-left:22rpx;padding-right:22rpx}.row{flex-wrap:wrap}.actions button{padding-left:16rpx;padding-right:16rpx}}
.access-panel{padding:24rpx;margin:24rpx 0;background:var(--ui-primary-soft);border:1rpx solid var(--ui-border);border-radius:var(--ui-radius-control)}.access-code{font-size:40rpx;line-height:1.5;font-weight:600;letter-spacing:3rpx;color:var(--ui-primary);overflow-wrap:anywhere}.cancellation-note{margin-top:20rpx}.cancel-booking{margin-top:20rpx;width:100%}
