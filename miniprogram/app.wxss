page{background:#edf4fc;color:#202d43;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}view,button,input,textarea{box-sizing:border-box}button{font-size:28rpx;border-radius:18rpx;line-height:1.6;padding:22rpx 24rpx;margin:0}button::after{border:0}button[disabled]{opacity:.5}.page{padding:28rpx 26rpx 52rpx}.card{background:#fff;border-radius:22rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 5rpx 18rpx rgba(42,75,113,.06)}.title{font-size:36rpx;font-weight:650;line-height:1.4;margin-bottom:14rpx}.subtitle{font-size:31rpx;font-weight:600;margin-bottom:16rpx}.muted{color:#718096;font-size:24rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.stack>view+view,.stack>button+button{margin-top:20rpx}.primary{background:#3478ff;color:white}.secondary{background:#edf3ff;color:#2e69d9}.danger{background:#fff0ef;color:#ce4545}.success{background:#e9f7ee;color:#238950}.notice{background:#fff7e7;color:#926b26;border-radius:16rpx;padding:20rpx;font-size:24rpx;margin-bottom:22rpx}.error{background:#fff0ef;color:#b33138;border-radius:16rpx;padding:20rpx;margin-bottom:24rpx}.empty{text-align:center;color:#718096;padding:70rpx 20rpx}.field{display:block;margin:24rpx 0}.label{display:block;font-size:26rpx;color:#59697f;margin-bottom:10rpx}input,textarea,.picker{display:block;width:100%;background:#f4f7fc;border:1rpx solid #e1e8f2;border-radius:14rpx;padding:20rpx;font-size:28rpx;min-height:84rpx}textarea{height:160rpx}.link{color:#3273ff}.divider{height:1rpx;background:#edf1f7;margin:22rpx 0}.badge{display:inline-block;border-radius:9rpx;padding:4rpx 13rpx;font-size:23rpx;background:#edf3ff;color:#3971d3}.badge.pending{background:#fff3d8;color:#a46c06}.badge.approved{background:#e4f6e9;color:#23894b}.badge.rejected,.badge.cancelled,.badge.expired{background:#f3f4f6;color:#718096}.filters{display:flex;gap:12rpx;flex-wrap:wrap;margin-bottom:22rpx}.chip{background:#fff;color:#66748b;border-radius:14rpx;padding:12rpx 20rpx;font-size:24rpx}.chip.active{background:#3478ff;color:#fff}.actions{display:flex;gap:20rpx;margin-top:24rpx}.actions button{flex:1}.kv{display:flex;justify-content:space-between;gap:24rpx;padding:12rpx 0}.kv text:first-child{color:#718096;flex-shrink:0}.kv text:last-child{text-align:right;word-break:break-all}.admin-title{color:#22865e}.small{font-size:24rpx}.bottom-space{height:30rpx}
