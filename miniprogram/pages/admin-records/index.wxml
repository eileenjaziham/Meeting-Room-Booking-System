<mode-banner /><view class="page"><view class="title admin-title">预约台账 / 学生审批</view><view class="card"><view class="row"><picker range="{{rooms}}" value="{{roomIndex}}" bindchange="room"><view class="link">{{rooms[roomIndex]}} ⌄</view></picker><picker mode="date" value="{{date}}" bindchange="date"><view class="link">{{date || '全部日期'}} ⌄</view></picker></view><label class="field"><text class="label">申请人姓名 / 学工号</text><input value="{{applicant}}" bindinput="applicant" bindconfirm="load" confirm-type="search" placeholder="输入关键词" maxlength="50" /></label><view class="actions"><button class="secondary" bindtap="clear">清除条件</button><button class="success" bindtap="load">查询</button></view></view><view class="filters"><view wx:for="{{filters}}" wx:key="value" class="chip {{status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="filter">{{item.label}}</view></view><view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">重试</view></view><view wx:if="{{loading}}" class="empty">读取台账中…</view><view wx:elif="{{!records.length && !error}}" class="empty">暂无符合条件的预约</view><view wx:for="{{records}}" wx:key="id"><view class="muted">{{item.applicantName}} · {{item.studentNo}}</view><booking-card record="{{item}}" bind:open="open" /></view></view>
