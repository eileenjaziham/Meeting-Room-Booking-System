<mode-banner /><view class="page"><view wx:if="{{error}}" class="error">{{error}}<view bindtap="load" class="link">重试读取结果</view></view><view wx:if="{{record}}" class="card result"><view class="result-icon">{{record.status === 'pending' ? '◷' : '✓'}}</view><view class="title">{{record.status === 'pending' ? '申请已提交，等待管理员审核' : record.statusText}}</view><view class="muted">{{record.status === 'pending' ? '申请已占用时段，但尚未获准使用；到开始时间仍未审核将失效。' : '请在“我的预约”查看最新状态。'}}</view><view class="divider"></view><view>{{record.roomId}} 会议室</view><view>{{record.date}}　{{record.start}}—{{record.end}}</view><view class="muted">预约编号：{{record.id}}</view><view class="stack"><button class="primary" bindtap="detail">查看预约详情</button><button class="secondary" bindtap="home">返回首页</button></view></view></view>
