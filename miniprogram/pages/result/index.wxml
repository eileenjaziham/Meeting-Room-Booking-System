<mode-banner /><view class="page">
 <feedback-state wx:if="{{error}}" kind="error" title="暂时无法读取结果" description="{{error}}" action-label="重新加载" bind:action="load" />
 <view wx:if="{{record}}" class="card result">
  <view class="result-icon {{record.status}}"><image class="result-symbol" src="{{record.status === 'pending' ? '/assets/icons/clock.svg' : record.status === 'approved' ? '/assets/icons/check.svg' : record.status === 'rejected' ? '/assets/icons/alert.svg' : '/assets/icons/calendar.svg'}}" mode="aspectFit" aria-hidden="true" /></view>
  <view class="title">{{record.status === 'pending' ? '申请已提交，等待管理员审核' : record.statusText}}</view><view class="muted">{{record.status === 'pending' ? '申请已占用时段，但尚未获准使用；到开始时间仍未审核将失效。' : '请在“我的预约”查看最新状态。'}}</view><view class="divider"></view><view>{{record.roomId}} 会议室</view><view>{{record.date}}　{{record.start}}—{{record.end}}</view>
  <view wx:if="{{record.accessCode}}" class="access-panel"><view class="label">会议室密码</view><view class="access-code" selectable="{{true}}">{{record.accessCode}}</view><view class="muted">请在预约有效时段内使用会议室。</view></view>
  <view class="muted">预约编号：{{record.id}}</view><view class="stack"><button class="primary" bindtap="detail">查看预约详情</button><button class="secondary" bindtap="home">返回首页</button><button wx:if="{{record.status === 'pending' || record.status === 'approved'}}" class="danger" bindtap="cancel" disabled="{{busy || !record.canCancel}}" loading="{{busy}}">取消预约</button></view>
  <view wx:if="{{record.status === 'pending' || record.status === 'approved'}}" class="muted cancellation-note">{{record.canCancel ? '取消预约须距会议开始至少5小时。' : '距会议开始不足5小时，无法自助取消；如需处理请联系曹闯老师，QQ：28061535。'}}</view>
 </view>
</view>
