.result{text-align:center;padding-top:50rpx}.result-icon{font-size:100rpx;color:var(--ui-primary)}.result .stack{margin-top:34rpx}.result .muted{word-break:break-all}
.result-icon{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;margin:0 auto 28rpx;border-radius:50%;background:var(--ui-primary-soft)}.result-icon.approved{background:var(--ui-success-soft)}.result-icon.rejected{background:var(--ui-danger-soft)}.result-symbol{width:54rpx;height:54rpx;display:block}.result .muted{word-break:normal;overflow-wrap:anywhere}.result .title{font-size:34rpx;line-height:1.5}
.result .stack{display:flex;flex-direction:column;gap:16rpx}.result .stack button{width:100%;margin:0}
