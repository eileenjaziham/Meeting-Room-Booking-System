.account-intro{margin-bottom:28rpx;line-height:1.7}.account-list{display:flex;flex-direction:column;gap:18rpx}.account-page .account-list button.account-option{display:flex;align-items:center;width:100%;min-height:120rpx;min-height:max(120rpx,60px);gap:20rpx;text-align:left;padding:24rpx;border:1rpx solid var(--ui-border);border-radius:var(--ui-radius-card);background:var(--ui-surface);box-shadow:var(--ui-shadow-card);color:var(--ui-text);margin:0;font-weight:400;line-height:1.5}.account-icon{width:72rpx;height:72rpx;flex-shrink:0;background:var(--ui-primary-soft);border-radius:20rpx;display:flex;align-items:center;justify-content:center}.account-icon.green{background:var(--ui-success-soft)}.account-icon.amber{background:var(--ui-warning-soft)}.account-icon image{width:40rpx;height:40rpx}.account-copy{flex:1;min-width:0}.account-name{font-size:29rpx;font-weight:600;margin-bottom:6rpx}.account-description{font-size:24rpx;color:var(--ui-text-muted);overflow-wrap:anywhere}.account-arrow{width:26rpx;height:26rpx;flex-shrink:0}.account-progress{font-size:23rpx;color:var(--ui-primary);flex-shrink:0}.account-page .account-list button.account-option[disabled]{background:var(--ui-field)}.account-page .account-list button.account-pressed{background:var(--ui-primary-soft)}.account-footnote{font-size:24rpx;text-align:center;margin:32rpx 16rpx 0}.cloud-note{margin-bottom:24rpx}.account-page .card button.cloud-login{width:100%}@media(max-width:350px){.account-page .account-list button.account-option{gap:16rpx;padding:22rpx}.account-name{font-size:28rpx}}
