<mode-banner /><view class="page"><view class="card"><view class="title">{{user.name || '我的'}}</view><view wx:if="{{user}}" class="muted">{{user.verification === 'approved' ? (user.identityType === 'teacher' ? '已核验教师' : '已核验学生') : '身份待核验'}}{{user.isAdmin ? ' · 授权负责人' : ''}}</view><button wx:else class="primary" bindtap="login">登录</button></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card stack"><button class="secondary" bindtap="bookings">我的预约　›</button><button class="secondary" bindtap="identity">身份信息　›</button><button class="secondary" bindtap="notices">预约须知　›</button><button wx:if="{{user.isAdmin}}" class="success" bindtap="admin">管理工作台　›</button></view><button wx:if="{{user}}" bindtap="logout">切换登录账号</button></view>
