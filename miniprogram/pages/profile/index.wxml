<mode-banner />
<view class="page profile-page">
  <view class="card profile-header">
    <view class="avatar"><image src="/assets/icons/profile.svg" mode="aspectFit" /></view>
    <view class="profile-heading">
      <view class="title">{{user.name || '我的'}}</view>
      <view wx:if="{{user}}" class="muted">{{user.verification === 'approved' ? (user.identityType === 'teacher' ? '已核验教师' : '已核验学生') : '身份待核验'}}{{user.isAdmin ? ' · 授权负责人' : ''}}</view>
      <text wx:else class="link" bindtap="login">点击登录</text>
    </view>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="card menu-card">
    <view class="profile-menu-row" bindtap="personalInfo" hover-class="row-pressed" role="button"><view class="icon-box"><image src="/assets/icons/profile.svg" mode="aspectFit" /></view><view class="menu-copy"><view class="menu-title">个人信息</view><view class="menu-description">姓名、学号与联系方式</view></view><image class="menu-arrow" src="/assets/icons/chevron.svg" /></view>
    <view class="profile-menu-row" bindtap="bookings" hover-class="row-pressed" role="button"><view class="icon-box"><image src="/assets/icons/calendar.svg" mode="aspectFit" /></view><view class="menu-copy"><view class="menu-title">我的预约</view><view class="menu-description">预约记录与审核进度</view></view><image class="menu-arrow" src="/assets/icons/chevron.svg" /></view>
    <view class="profile-menu-row" bindtap="feedback" hover-class="row-pressed" role="button"><view class="icon-box"><image src="/assets/icons/feedback.svg" mode="aspectFit" /></view><view class="menu-copy"><view class="menu-title">反馈中心</view><view class="menu-description">意见建议与处理回复</view></view><image class="menu-arrow" src="/assets/icons/chevron.svg" /></view>
    <view class="profile-menu-row" bindtap="notices" hover-class="row-pressed" role="button"><view class="icon-box"><image src="/assets/icons/notices.svg" mode="aspectFit" /></view><view class="menu-copy"><view class="menu-title">预约须知</view><view class="menu-description">预约规则与管理员联系</view></view><image class="menu-arrow" src="/assets/icons/chevron.svg" /></view>
    <view wx:if="{{user.isAdmin}}" class="profile-menu-row" bindtap="admin" hover-class="row-pressed" role="button"><view class="icon-box"><image src="/assets/icons/admin.svg" mode="aspectFit" /></view><view class="menu-copy"><view class="menu-title">管理工作台</view><view class="menu-description">申请审核与预约管理</view></view><image class="menu-arrow" src="/assets/icons/chevron.svg" /></view>
  </view>
  <view wx:if="{{user}}" class="switch-account" bindtap="logout" role="button" hover-class="row-pressed">切换登录账号</view>
  <view class="app-version"><view>会议室预约</view><view>当前版本 v{{version}}</view></view>
</view>
