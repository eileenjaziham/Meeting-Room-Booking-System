.profile-page{padding:28rpx 28rpx 36rpx}
.profile-header,.menu-card{border:1rpx solid var(--ui-border);border-radius:24rpx;box-shadow:0 4rpx 18rpx rgba(42,75,113,.035);margin-bottom:24rpx}
.profile-header{display:flex;align-items:center;padding:30rpx 26rpx;background:#fff}
.avatar-shell{position:relative;width:112rpx;height:112rpx;min-width:112rpx;flex:0 0 112rpx;margin-right:26rpx}
.avatar-button,.avatar-placeholder{position:absolute;left:0;top:0;width:112rpx;height:112rpx;min-width:0;max-width:112rpx;min-height:112rpx;margin:0;padding:0;line-height:normal;font-size:0;border:4rpx solid #fff;border-radius:50%;background:var(--ui-primary-soft);box-shadow:0 0 0 1rpx #d7e6e8;display:flex;align-items:center;justify-content:center;overflow:visible}
.avatar-image{display:block;width:62rpx;height:62rpx;border-radius:50%}
.avatar-image.custom-avatar{width:104rpx;height:104rpx}
.avatar-camera{position:absolute;right:-3rpx;bottom:-1rpx;width:34rpx;height:34rpx;display:flex;align-items:center;justify-content:center;background:var(--ui-primary);border:3rpx solid #fff;border-radius:50%}
.camera-image{width:21rpx;height:21rpx;display:block}
.profile-heading{flex:1;min-width:0}
.profile-name{font-size:34rpx;font-weight:600;line-height:1.4;color:#24364b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.profile-badges{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx;margin-top:10rpx}
.identity-tag{display:inline-block;font-size:21rpx;line-height:32rpx;padding:0 12rpx;color:#407785;background:var(--ui-primary-soft);border-radius:8rpx;white-space:nowrap}
.avatar-note{margin-top:12rpx;font-size:21rpx;color:var(--ui-text-muted);line-height:1.5}
.profile-login{display:block;color:var(--ui-primary);font-size:25rpx;margin-top:12rpx}
.menu-card{padding:0 26rpx;background:#fff;overflow:hidden}
.profile-menu-row{display:flex;align-items:center;width:100%;height:112rpx;border-bottom:1rpx solid var(--ui-border)}
.profile-menu-row:last-child{border-bottom:0}
.icon-box{width:62rpx;height:62rpx;flex:0 0 62rpx;margin-right:22rpx;display:flex;align-items:center;justify-content:center;background:var(--ui-primary-soft);border-radius:18rpx}
.menu-icon{width:36rpx;height:36rpx;display:block}
.menu-title{flex:1;min-width:0;font-size:28rpx;line-height:1.5;font-weight:500;color:#33445e}
.menu-arrow{width:25rpx;height:25rpx;flex:0 0 25rpx;display:block}
.row-pressed{opacity:.65}
.switch-account{display:flex;align-items:center;justify-content:center;height:90rpx;width:100%;background:#fff;border:1rpx solid var(--ui-border);border-radius:24rpx;color:var(--ui-text-muted);font-size:25rpx}
.switch-icon{width:30rpx;height:30rpx;margin-right:12rpx;display:block}
.app-version{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;padding-top:34rpx;color:var(--ui-text-muted);font-size:21rpx;line-height:1.8}
.version-divider{margin:0 12rpx;color:#bdc7d5}
.profile-header,.menu-card,.switch-account{border-color:var(--ui-border);border-radius:var(--ui-radius-card);box-shadow:var(--ui-shadow-card)}.profile-name{color:var(--ui-text);white-space:normal;word-break:normal;overflow-wrap:anywhere}.identity-tag{font-size:24rpx;line-height:1.5;color:var(--ui-primary);background:var(--ui-primary-soft);padding:3rpx 10rpx}.avatar-note{font-size:24rpx;color:var(--ui-text-muted)}.profile-menu-row{border-color:var(--ui-border);transition:background-color var(--ui-motion-fast)}.icon-box{background:var(--ui-primary-soft)}.menu-title{color:var(--ui-text)}.row-pressed{opacity:1;background:var(--ui-field)}.switch-account{color:var(--ui-text-muted);min-height:44px}.app-version{font-size:24rpx;color:var(--ui-text-muted)}@media(prefers-reduced-motion:reduce){.profile-menu-row{transition:none}}
.message-reminder{display:flex;align-items:center;gap:8rpx;font-size:22rpx;color:var(--ui-danger);flex-shrink:0}.reminder-dot{width:12rpx;height:12rpx;min-width:6px;min-height:6px;background:var(--ui-danger);border-radius:50%}
