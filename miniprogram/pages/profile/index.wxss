.profile-page{min-height:85vh;display:flex;flex-direction:column;padding:32rpx 28rpx 36rpx}.profile-header{display:flex;align-items:center;gap:26rpx;padding:34rpx 30rpx;border-radius:26rpx;background:linear-gradient(120deg,#fff,#f6f9ff);box-shadow:0 5rpx 20rpx #31598f08}.avatar{width:100rpx;height:100rpx;flex-shrink:0;border-radius:50%;background:#e6efff;display:flex;align-items:center;justify-content:center}.avatar image{width:58rpx;height:58rpx}.profile-heading{flex:1}.profile-heading .title{font-size:34rpx;margin-bottom:8rpx}.profile-heading .muted{font-size:24rpx;color:#8a9ab0}.menu-card{padding:0 28rpx;border-radius:26rpx;overflow:hidden}.profile-menu-row{display:flex;align-items:center;gap:24rpx;width:100%;height:132rpx;padding:0 4rpx;border-bottom:1rpx solid #edf2f8}.profile-menu-row:last-child{border-bottom:0}.icon-box{width:72rpx;height:72rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:#eef4ff;border-radius:20rpx}.icon-box image{width:42rpx;height:42rpx}.menu-copy{flex:1;min-width:0}.menu-title{font-size:29rpx;font-weight:600;line-height:1.5;color:#2a3a50}.menu-description{font-size:22rpx;line-height:1.6;color:#92a0b4;margin-top:5rpx}.menu-arrow{width:30rpx;height:30rpx;flex-shrink:0}.row-pressed{opacity:.7}.switch-account{display:flex;align-items:center;justify-content:center;width:100%;height:90rpx;border-radius:20rpx;background:#fff;color:#71839e;font-size:26rpx;letter-spacing:1rpx;margin:0 0 24rpx}.app-version{text-align:center;font-size:21rpx;color:#a5b1c3;line-height:1.9;padding-top:26rpx;margin-top:auto}