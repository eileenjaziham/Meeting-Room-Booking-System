.profile-page{min-height:85vh;display:flex;flex-direction:column}.profile-header{display:flex;align-items:center;gap:24rpx;padding:36rpx 30rpx}.profile-heading{flex:1}.profile-heading .title{margin-bottom:6rpx}.avatar{position:relative;flex-shrink:0;width:106rpx;height:106rpx;border-radius:50%;background:#e9f1ff;overflow:hidden}.avatar-head{position:absolute;top:21rpx;left:37rpx;width:32rpx;height:32rpx;border:4rpx solid #729ae1;border-radius:50%}.avatar-body{position:absolute;top:64rpx;left:22rpx;width:62rpx;height:40rpx;border:4rpx solid #729ae1;border-radius:36rpx 36rpx 0 0}.menu-card{padding:0 28rpx}.menu-item{width:100%;display:flex;align-items:center;justify-content:space-between;min-height:114rpx;padding:24rpx 0;background:#fff;border-radius:0;text-align:left;color:#26354b;border-bottom:1rpx solid #edf1f7}.menu-item:last-child{border-bottom:0}.menu-left{display:flex;align-items:center;gap:22rpx}.menu-icon{font-size:38rpx;line-height:1;width:44rpx;text-align:center;color:#4e83dd}.menu-description{font-size:22rpx;color:#8a97aa;line-height:1.6;margin-top:4rpx}.menu-arrow{font-size:40rpx;line-height:1;color:#a7b4c6}.admin-entry,.admin-entry .menu-icon{color:#22865e}.switch-account{width:100%;background:#fff;color:#70819b;margin-top:4rpx}.app-version{text-align:center;font-size:22rpx;color:#9aa9bd;line-height:1.9;padding-top:48rpx;margin-top:auto}
