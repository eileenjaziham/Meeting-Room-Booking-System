<view class="page manage-page">
 <view class="title">会议室管理</view><view class="muted intro">维护会议室资料，安排停用或解除停用。</view>
 <button class="primary action-button" bindtap="newRoom" disabled="{{busy}}">新增会议室</button>
 <feedback-state wx:if="{{loading}}" kind="loading" title="正在读取会议室" />
 <view wx:if="{{rooms.length}}" class="card room-picker">
  <view class="section-heading"><text class="subtitle">选择会议室</text><text class="muted">共 {{rooms.length}} 间</text></view>
  <view class="room-list"><view wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="select" hover-class="room-option-pressed" class="room-option {{selected.id === item.id ? 'chosen' : ''}}" role="button" aria-label="{{item.number}}会议室，{{item.capacity}}人，{{item.blockCount ? '有停用安排' : '正常开放'}}" aria-pressed="{{selected.id === item.id}}">
   <view class="room-number">{{item.number}}</view><view class="room-info"><view class="room-capacity">容纳 {{item.capacity}} 人</view><view class="room-equipment">{{item.equipment}}</view></view><view class="room-state {{item.blockCount ? 'scheduled' : ''}}">{{item.blockCount ? item.blockCount + ' 项停用' : '正常开放'}}</view><image class="room-arrow" src="{{selected.id === item.id ? '/assets/icons/check.svg' : '/assets/icons/chevron.svg'}}" mode="aspectFit" aria-hidden="true" />
  </view></view>
 </view>
 <view wx:if="{{editing}}" id="room-editor" class="card room-editor">
  <view class="section-heading"><text class="subtitle">{{form.id ? '编辑会议室' : '新增会议室'}}</text><text class="muted">核心资料</text></view>
  <form-field name="id" label="会议室编号" value="{{form.id}}" required="{{true}}" maxlength="50" disabled="{{isEdit || busy}}" placeholder="例如 7060" helper="{{isEdit ? '编号创建后不可修改' : '系统内唯一，如房间号 7060'}}" bind:change="roomField" />
  <form-field name="number" label="会议室名称" value="{{form.number}}" maxlength="50" disabled="{{busy}}" placeholder="留空则与编号相同" helper="显示在列表和日程中的名称" bind:change="roomField" />
  <form-field name="capacity" label="容量" value="{{form.capacity}}" type="number" required="{{true}}" maxlength="5" disabled="{{busy}}" placeholder="例如 10" bind:change="roomField" />
  <form-field name="location" label="位置" value="{{form.location}}" required="{{true}}" maxlength="200" disabled="{{busy}}" placeholder="例如 南湖校区综合楼七楼" bind:change="roomField" />
  <form-field name="equipment" label="设备" value="{{form.equipment}}" required="{{true}}" maxlength="200" disabled="{{busy}}" placeholder="例如 屏幕、投影" bind:change="roomField" />
  <form-field name="open" label="开放时间" value="{{form.open}}" required="{{true}}" maxlength="50" disabled="{{busy}}" placeholder="例如 08:00—22:00" bind:change="roomField" />
  <view class="photo-field">
   <text class="label">会议室图片</text>
   <view wx:if="{{form.photo}}" class="photo-thumb"><image src="{{form.photo}}" mode="aspectFill" aria-label="{{form.photoNote || '会议室图片预览'}}" /><view class="photo-remove" role="button" aria-label="移除图片" bindtap="removePhoto" hover-class="tap-pressed">×</view></view>
   <view wx:else class="photo-empty" role="button" hover-class="photo-empty-pressed" aria-label="从相册或相机选择本地图片" bindtap="choosePhoto">
    <image class="photo-empty-icon" src="/assets/icons/plus.svg" mode="aspectFit" aria-hidden="true" />
    <text class="photo-empty-text">{{photoBusy ? '正在处理图片…' : '选择本地图片'}}</text>
    <text class="photo-empty-hint">从相册或相机选取 JPG / PNG，自动压缩</text>
   </view>
   <view wx:if="{{form.photo}}" class="photo-actions"><button class="secondary" bindtap="choosePhoto" disabled="{{busy || photoBusy}}" loading="{{photoBusy}}">重新选择</button></view>
  </view>
  <form-field name="photoNote" label="图片说明" value="{{form.photoNote}}" maxlength="200" disabled="{{busy}}" placeholder="可选" bind:change="roomField" />
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="editor-actions"><button class="primary" bindtap="saveRoom" disabled="{{busy}}" loading="{{busy}}">保存资料</button><button class="secondary" bindtap="cancelEdit" disabled="{{busy}}">取消</button></view>
 </view>
 <view id="manage-form"></view>
 <block wx:if="{{selected}}">
  <view class="card block-form">
   <view class="section-heading"><text class="subtitle">安排停用</text><view class="room-summary-actions"><view class="mini-btn {{busy ? 'is-disabled' : ''}}" role="button" aria-label="编辑 {{selected.number}} 会议室资料" hover-class="mini-btn-pressed" bindtap="editRoom">编辑资料</view><view class="mini-btn danger-outline {{busy ? 'is-disabled' : ''}}" role="button" aria-label="删除 {{selected.number}} 会议室" hover-class="mini-btn-pressed" bindtap="deleteRoom">删除</view></view></view>
   <view class="room-summary">
    <text class="selected-room">{{selected.number}} 会议室</text>
    <text class="state-chip {{selected.blockCount ? 'is-scheduled' : ''}}">{{selected.blockCount ? selected.blockCount + ' 项停用中' : '正常开放'}}</text>
    <text class="muted room-location">{{selected.location}} · 固定容量 {{selected.capacity}} 人</text>
   </view>
   <view class="date-fields">
    <view class="manage-field"><text class="label">开始日期</text><picker mode="selector" range="{{dateOptions}}" range-key="label" value="{{startDateIndex}}" data-field="startDate" bindchange="changeDate" disabled="{{busy}}" aria-label="选择停用开始日期"><view class="manage-control"><image class="control-icon" src="/assets/icons/calendar.svg" mode="aspectFit" /><text class="control-value">{{startDateLabel}}</text><image class="control-chevron" src="/assets/icons/chevron.svg" mode="aspectFit" /></view></picker></view>
    <view class="manage-field"><text class="label">结束日期</text><picker mode="selector" range="{{dateOptions}}" range-key="label" value="{{endDateIndex}}" data-field="endDate" bindchange="changeDate" disabled="{{busy}}" aria-label="选择停用结束日期"><view class="manage-control"><image class="control-icon" src="/assets/icons/calendar.svg" mode="aspectFit" /><text class="control-value">{{endDateLabel}}</text><image class="control-chevron" src="/assets/icons/chevron.svg" mode="aspectFit" /></view></picker></view>
   </view>
   <view class="time-fields">
    <view class="manage-field"><text class="label">开始时间</text><picker mode="selector" range="{{startOptions}}" value="{{startIndex}}" data-field="start" bindchange="changeTime" disabled="{{busy}}" aria-label="选择停用开始时间"><view class="manage-control"><image class="control-icon" src="/assets/icons/clock.svg" mode="aspectFit" /><text class="control-value time-value">{{start}}</text><image class="control-chevron" src="/assets/icons/chevron.svg" mode="aspectFit" /></view></picker></view>
    <view class="manage-field"><text class="label">结束时间</text><picker mode="selector" range="{{endOptions}}" value="{{endIndex}}" data-field="end" bindchange="changeTime" disabled="{{busy}}" aria-label="选择停用结束时间"><view class="manage-control"><image class="control-icon" src="/assets/icons/clock.svg" mode="aspectFit" /><text class="control-value time-value">{{end}}</text><image class="control-chevron" src="/assets/icons/chevron.svg" mode="aspectFit" /></view></picker></view>
   </view>
   <form-field name="blockReason" label="停用原因" value="{{reason}}" required="{{true}}" multiline="{{true}}" maxlength="200" disabled="{{busy}}" placeholder="例如设备检修、临时维护" helper="确认前可预览受影响预约；停用将通知相关预约人。" bind:change="field" />
   <view wx:if="{{error}}" class="error">{{error}}</view>
   <button class="secondary action-button" bindtap="preview" disabled="{{busy}}" loading="{{busy}}">预览受影响预约</button>
   <view wx:if="{{preview}}" class="preview"><view class="preview-heading"><text>停用影响预览</text><text class="impact-count">{{preview.affected.length}} 条预约</text></view><view class="notice">确认后将取消以下预约，并发送站内通知。解除停用不会恢复原预约。</view><view wx:if="{{!preview.affected.length}}" class="muted">该时段暂无受影响预约。</view><view wx:for="{{preview.affected}}" wx:key="id" class="affected"><view class="affected-heading"><text>{{item.borrowerName || item.applicantName}}</text><status-tag status="{{item.status}}" label="{{item.statusText}}" /></view><view class="muted">{{item.date}}　{{item.start}}—{{item.end}}</view></view><button class="danger action-button" bindtap="confirm" disabled="{{busy}}">确认停用 {{selected.number}} 会议室</button></view>
  </view>
  <view id="block-history" class="card history-card"><view class="section-heading"><text class="subtitle">停用与恢复记录</text><text class="muted">{{selected.blocks.length}} 条</text></view><view wx:if="{{!selected.blocks.length}}" class="history-empty">暂无停用记录</view>
   <view wx:for="{{selected.blocks}}" wx:key="id" class="block-record"><view class="record-heading"><text class="block-status {{item.canRelease ? 'is-active' : ''}}">{{item.statusText}}</text><text class="record-actor">{{item.createdByName}}</text></view><view class="record-period"><view>{{item.startDate}}　{{item.start}}</view><view class="muted">至 {{item.endDate}}　{{item.end}}</view></view><view class="record-reason">{{item.reason}}</view><view class="muted">已取消 {{item.cancelledCount}} 条预约</view><view wx:if="{{item.releaseReason}}" class="release-note">恢复原因：{{item.releaseReason}}<view class="muted">处理人：{{item.releasedByName}}</view></view><button wx:if="{{item.canRelease}}" class="secondary action-button" data-id="{{item.id}}" bindtap="release" disabled="{{busy}}">解除停用</button></view>
  </view>
 </block>
 <view wx:elif="{{rooms.length}}" class="muted choose-note">选择上方会议室后，可安排停用并查看历史记录。</view>
 <feedback-state wx:if="{{!loading && error && !selected}}" kind="error" title="暂时无法读取会议室" description="{{error}}" action-label="重新加载" bind:action="load" />
</view>
