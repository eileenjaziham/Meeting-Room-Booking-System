.intro{margin-bottom:24rpx}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:20rpx;flex-wrap:wrap}.section-heading .subtitle{margin:0}.room-picker{padding-bottom:12rpx}.room-list{display:flex;flex-direction:column;gap:12rpx}.room-option{display:flex;align-items:center;gap:16rpx;min-height:112rpx;padding:18rpx 14rpx;border:1rpx solid var(--ui-border);border-radius:16rpx;background:var(--ui-surface);min-width:0}.room-option.chosen{border-color:var(--ui-primary);background:var(--ui-primary-soft)}.room-option-pressed{background:var(--ui-field)}.room-number{font-size:31rpx;font-weight:650;color:var(--ui-text);flex-shrink:0}.room-info{flex:1;min-width:0;line-height:1.6}.room-capacity{font-size:25rpx;color:var(--ui-text)}.room-equipment{font-size:23rpx;color:var(--ui-text-muted);overflow-wrap:anywhere}.room-state{font-size:22rpx;color:var(--ui-success);background:var(--ui-success-soft);padding:5rpx 9rpx;border-radius:8rpx;flex-shrink:0;line-height:1.5}.room-state.scheduled{color:var(--ui-warning);background:var(--ui-warning-soft)}.room-arrow{width:26rpx;height:26rpx;flex-shrink:0}.selected-room{color:var(--ui-primary);font-size:26rpx;background:var(--ui-primary-soft);padding:6rpx 12rpx;border-radius:10rpx}.room-location{margin-top:-6rpx;margin-bottom:28rpx}.manage-field{min-width:0}.date-fields{display:flex;flex-direction:column;gap:22rpx;margin-bottom:24rpx}.time-fields{display:flex;gap:20rpx;margin-bottom:28rpx}.time-fields>.manage-field{flex:1}.manage-control{display:flex;align-items:center;gap:12rpx;min-height:96rpx;min-height:max(96rpx,44px);padding:18rpx 20rpx;border:1rpx solid var(--ui-border);border-radius:16rpx;background:var(--ui-field)}.control-icon{width:29rpx;height:29rpx;flex-shrink:0}.control-value{flex:1;min-width:0;font-size:27rpx;line-height:1.5;overflow-wrap:anywhere;color:var(--ui-text)}.control-chevron{width:22rpx;height:22rpx;flex-shrink:0}.time-value{font-size:33rpx;color:var(--ui-primary);font-weight:600}.manage-page .card button.action-button{width:100%;min-height:44px;margin:0}.preview{border-top:1rpx solid var(--ui-border);padding-top:28rpx;margin-top:28rpx}.preview-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:29rpx;font-weight:600;margin-bottom:18rpx}.impact-count{font-size:24rpx;color:var(--ui-warning);font-weight:500}.affected{padding:20rpx 0;border-bottom:1rpx solid var(--ui-border)}.affected-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:8rpx;font-size:27rpx}.manage-page .preview button{margin-top:24rpx}.history-empty{text-align:center;color:var(--ui-text-muted);font-size:26rpx;padding:30rpx 0}.block-record{padding:24rpx 0;border-top:1rpx solid var(--ui-border);font-size:27rpx;line-height:1.7;overflow-wrap:anywhere}.record-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx}.block-status{padding:4rpx 12rpx;border-radius:8rpx;font-size:24rpx;color:var(--ui-neutral);background:var(--ui-neutral-soft);flex-shrink:0}.block-status.is-active{color:var(--ui-warning);background:var(--ui-warning-soft)}.record-actor{color:var(--ui-text-muted);font-size:24rpx;min-width:0;text-align:right}.record-period{margin-bottom:12rpx}.record-reason{margin-bottom:8rpx}.release-note{background:var(--ui-field);border-radius:12rpx;padding:16rpx;margin-top:16rpx}.manage-page .block-record button{margin-top:20rpx}.choose-note{text-align:center;padding:16rpx 20rpx;line-height:1.8}@media(max-width:350px){.room-option{gap:10rpx;padding:18rpx 10rpx}.room-number{font-size:29rpx}.room-state{font-size:21rpx;padding:5rpx 7rpx}.room-arrow{width:22rpx;height:22rpx}.manage-control{padding:16rpx 12rpx;gap:8rpx}.time-value{font-size:31rpx}.time-fields{gap:16rpx}.control-chevron{width:18rpx;height:18rpx}.control-icon{width:25rpx;height:25rpx}}
