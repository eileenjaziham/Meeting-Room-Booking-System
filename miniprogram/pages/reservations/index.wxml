<mode-banner /><view class="page"><view class="title">我的预约</view><view class="filters"><view wx:for="{{filters}}" wx:key="value" class="chip {{status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="filter">{{item.label}}</view></view><view class="row card"><picker mode="date" value="{{date}}" bindchange="date"><view class="link">{{date || '按日期筛选'}} ⌄</view></picker><text class="link small" bindtap="clear">清除日期</text></view><view class="error" wx:if="{{error}}">{{error}}<view class="row"><text class="link" bindtap="load">重试</text><text class="link" bindtap="login">登录</text></view></view><view wx:if="{{loading}}" class="empty">正在读取预约…</view><view wx:elif="{{!records.length && !error}}" class="empty">暂无符合条件的预约</view><booking-card wx:for="{{records}}" wx:key="id" record="{{item}}" bind:open="open" /></view>
