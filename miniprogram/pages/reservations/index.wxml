<mode-banner />
<view class="page">
 <view class="title">我的预约</view>
 <view wx:for="{{notifications}}" wx:key="id" class="notice" data-id="{{item.id}}" bindtap="notice"><view>{{item.content}}</view><view class="link">查看预约详情　›</view></view>
 <view class="filters"><view wx:for="{{filters}}" wx:key="value" class="chip {{status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="filter">{{item.label}}</view></view>
 <view class="row card"><picker mode="date" value="{{date}}" bindchange="date"><view class="link">{{date || '按日期筛选'}} ⌄</view></picker><text class="link small" bindtap="clear">清除日期</text></view>
 <view class="error" wx:if="{{error}}">{{error}}<view class="row"><text class="link" bindtap="load">重试</text><text class="link" bindtap="login">登录</text></view></view>
 <feedback-state wx:if="{{loading}}" kind="loading" title="正在读取预约" /><feedback-state wx:elif="{{!records.length && !error}}" title="暂无符合条件的预约" description="可调整筛选条件，或返回首页选择会议室。" />
 <booking-card wx:for="{{records}}" wx:key="id" record="{{item}}" bind:open="open" />
</view>
