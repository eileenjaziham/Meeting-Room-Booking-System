<mode-banner />
<view class="page">
  <view class="title">填写预约信息</view>
  <view class="card"><view class="subtitle">{{roomId}} 会议室</view><view>{{dateLabel}}　{{start}}—{{end}}</view><view class="muted">北京时间 · 预约范围含今天共7天</view></view>
  <view wx:if="{{loading}}" class="notice">正在读取预约资料…</view>
  <view wx:elif="{{user}}" class="notice">{{user.identityType === 'teacher' ? '教师合法预约提交后直接成功。' : '学生提交后为待确认，并占用该时段；须由负责人审核。'}}</view>
  <view class="error" wx:if="{{error}}">{{error}}<view wx:if="{{!ready}}" class="link" bindtap="load">重新加载预约资料</view></view>
  <view class="card">
    <label class="field"><text class="label">负责老师 *</text><input value="{{responsibleTeacher}}" data-field="responsibleTeacher" bindinput="field" maxlength="50" placeholder="请输入本次借用的负责老师姓名" /></label>
    <label class="field"><text class="label">借用人 *</text><input value="{{borrowerName}}" data-field="borrowerName" bindinput="field" maxlength="50" placeholder="请输入实际借用人姓名" /></label>
    <label class="field"><text class="label">使用用途 *</text><input value="{{purpose}}" data-field="purpose" bindinput="field" maxlength="200" placeholder="如：课程研讨、课题组会议" /></label>
    <label class="field"><text class="label">预计人数 *{{capacity !== null ? '（容量 ' + capacity + ' 人）' : ''}}</text><input value="{{attendees}}" type="number" data-field="attendees" bindinput="field" maxlength="9" placeholder="正整数" /></label>
    <label class="field"><text class="label">联系电话 *</text><input value="{{phone}}" type="number" data-field="phone" bindinput="field" maxlength="11" placeholder="11位手机号" /></label>
    <label class="field"><text class="label">备注（选填）</text><textarea value="{{notes}}" data-field="notes" bindinput="field" maxlength="500" placeholder="补充使用说明" /></label>
    <view wx:if="{{!user && !loading}}" class="login-required" bindtap="login">登录后即可提交，点击返回登录页</view>
    <button class="primary submit-booking" loading="{{busy || loading}}" disabled="{{busy || loading}}" bindtap="submit">{{!user ? '登录后提交' : user.identityType === 'teacher' ? '提交预约' : '提交申请，等待审核'}}</button>
    <view class="muted submit-note">网络异常后可保持内容重试，系统会防止重复提交。也可在“我的预约”查看最终结果。</view>
  </view>
</view>
