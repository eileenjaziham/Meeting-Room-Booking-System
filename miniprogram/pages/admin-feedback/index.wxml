<view class="page">
  <view class="title admin-title">用户反馈</view>
  <view class="filters"><view wx:for="{{filters}}" wx:key="value" class="chip {{status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="filter">{{item.label}}</view></view>
  <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">刷新反馈</view></view>
  <view wx:if="{{loading}}" class="empty">正在读取反馈…</view><view wx:elif="{{!records.length && !error}}" class="empty">暂无符合条件的反馈</view>
  <view class="card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="select">
    <view class="row"><text class="subtitle">{{item.categoryText}}</text><text class="badge {{item.status === 'pending' ? 'pending' : 'approved'}}">{{item.statusText}}</text></view>
    <view class="muted">{{item.applicantName}} · {{item.createdText}}</view><view class="content">{{item.content}}</view>
    <view wx:if="{{item.reply}}" class="reply">回复：{{item.reply}}</view><text wx:else class="link small">点击回复　›</text>
  </view>
  <view wx:if="{{selected && selected.status === 'pending'}}" class="card reply-editor">
    <view class="subtitle">回复：{{selected.applicantName}}</view><view class="muted content">{{selected.content}}</view>
    <textarea value="{{reply}}" bindinput="reply" maxlength="1000" placeholder="请输入给用户的回复" disabled="{{busy}}" />
    <button class="success" bindtap="submit" disabled="{{busy}}" loading="{{busy}}">提交回复</button>
  </view>
</view>
