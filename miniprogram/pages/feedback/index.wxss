.intro{margin-bottom:26rpx}.tabs{display:flex;background:#dfeafb;border-radius:16rpx;padding:6rpx;margin-bottom:24rpx}.tab{flex:1;padding:16rpx;text-align:center;border-radius:12rpx;color:var(--ui-text-muted)}.tab.selected{background:#fff;color:var(--ui-primary);font-weight:600}.filters .chip{background:#f1f5fb}.filters .chip.active{background:var(--ui-primary)}.feedback-input{height:280rpx;line-height:1.8}.counter{text-align:right;color:var(--ui-text-muted);font-size:22rpx;margin-top:-16rpx}.privacy-note{font-size:22rpx;margin:20rpx 0 28rpx}.feedback-success{background:#e6f6ec;color:#278452}.feedback-content{white-space:pre-wrap;word-break:break-all;margin:12rpx 0 18rpx;line-height:1.8}.feedback-record .subtitle{margin-bottom:0}.reply{background:var(--ui-primary-soft);border-radius:14rpx;padding:22rpx;margin-top:24rpx}.reply-title{font-size:25rpx;font-weight:600;color:#4b79c8}.pending-hint,.login-hint{margin:20rpx 0}
.tabs{background:var(--ui-primary-soft);border:1rpx solid var(--ui-border);padding:6rpx;gap:8rpx}.tab{min-height:44px;display:flex;align-items:center;justify-content:center;color:var(--ui-text-muted);font-size:27rpx}.tab.selected{color:var(--ui-primary);box-shadow:0 2rpx 10rpx rgba(36,65,106,.06)}.filters .chip{background:#fff}.filters .chip.active{color:var(--ui-primary);background:var(--ui-primary-soft);border-color:var(--ui-primary)}.counter,.privacy-note{font-size:24rpx;color:var(--ui-text-muted)}.feedback-content{word-break:normal;overflow-wrap:anywhere}.feedback-success{background:var(--ui-success-soft);color:var(--ui-success)}.reply{background:var(--ui-primary-soft);border:1rpx solid var(--ui-border);border-radius:16rpx}.reply-title{color:var(--ui-primary)}
