<view class="page">
 <view class="title">{{admin ? '管理申请详情' : '预约详情'}}</view>
 <view class="error" wx:if="{{error}}">{{error}}<view class="link" bindtap="load">刷新最新状态</view></view>
 <block wx:if="{{record}}">
  <view class="card"><view class="row"><text class="subtitle">{{record.roomId}} 会议室</text><status-tag status="{{record.status}}" label="{{record.statusText}}" /></view><view>{{record.date}}　{{record.start}}—{{record.end}}</view><view class="muted">北京时间</view>
   <view wx:if="{{record.accessCode}}" class="access-panel"><view class="label">会议室密码</view><view class="access-code" selectable="{{true}}">{{record.accessCode}}</view><view class="muted">请在预约有效时段内使用会议室。</view></view>
   <view class="divider"></view><view class="kv"><text>申请人</text><text>{{record.applicantName}}</text></view><view class="kv"><text>学工号</text><text>{{record.studentNo}}</text></view><view class="kv"><text>负责老师</text><text>{{record.responsibleTeacher || '历史记录未填写'}}</text></view><view class="kv"><text>借用人</text><text>{{record.borrowerName || record.applicantName}}</text></view><view class="kv"><text>使用用途</text><text>{{record.purpose}}</text></view><view class="kv"><text>预计人数</text><text>{{record.attendees}} 人</text></view><view class="kv"><text>联系电话</text><text>{{record.phone}}</text></view><view wx:if="{{record.notes}}" class="kv"><text>备注</text><text>{{record.notes}}</text></view>
  </view>
  <view class="card"><view class="muted">预约编号：{{record.id}}</view><view class="kv"><text>提交时间</text><text>{{createdAt}}</text></view><view wx:if="{{reviewedAt}}" class="kv"><text>审核时间</text><text>{{reviewedAt}}</text></view><view wx:if="{{record.reviewedBy}}" class="kv"><text>处理人 ID</text><text>{{record.reviewedBy}}</text></view><view wx:if="{{cancelledAt}}" class="kv"><text>取消时间</text><text>{{cancelledAt}}</text></view><view wx:if="{{record.reason}}">处理原因：{{record.reason}}</view><view wx:if="{{record.status === 'pending'}}" class="notice">尚未审批通过。到开始时间仍未审核，申请自动视为失效。</view><view wx:if="{{record.status === 'completed'}}" class="muted">已完成仅表示预约时段结束，不证明实际使用或签到。</view></view>
  <view wx:if="{{admin && record.status === 'pending'}}" class="card"><text class="label">拒绝原因（拒绝必填，最多500字）</text><textarea value="{{reason}}" bindinput="reason" maxlength="500" /><view class="actions"><button class="danger" data-decision="reject" bindtap="review" disabled="{{busy}}">拒绝</button><button class="success" data-decision="approve" bindtap="review" disabled="{{busy}}">批准</button></view></view>
  <view wx:if="{{admin && record.canAdminCancel}}" class="card"><view class="subtitle">管理员取消预约</view><view class="muted">可取消他人的有效预约，不受提前5小时限制。原因将通知预约人。</view><label class="field"><text class="label">取消原因 <text class="required">*</text></text><textarea value="{{cancelReason}}" bindinput="cancelReason" maxlength="200" disabled="{{busy}}" placeholder="请输入取消原因（最多200字）" /></label><button class="danger" bindtap="cancel" disabled="{{busy}}" loading="{{busy}}">管理员取消此预约</button></view>
  <view wx:if="{{!admin && (record.status === 'pending' || record.status === 'approved')}}" class="card"><view class="muted">须至少提前5小时取消。自助取消截止：{{cancelDeadline}}（北京时间）。</view><button class="danger cancel-booking" bindtap="cancel" disabled="{{busy || !record.canCancel}}" loading="{{busy}}">取消预约</button><view wx:if="{{!record.canCancel}}" class="notice cancellation-note">距会议开始不足5小时，无法自助取消。如需处理请联系曹闯老师，QQ：28061535。</view></view>
 </block>
</view>
