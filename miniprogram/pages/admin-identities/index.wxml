<mode-banner /><view class="page"><view class="title admin-title">用户身份审核</view><view class="notice">此版本仅核验虚构测试资料，未对接学校 SSO。身份审核不授予管理员权限。</view><view class="filters"><view wx:for="{{filters}}" wx:key="value" class="chip {{status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="filter">{{item.label}}</view></view><view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">刷新记录</view></view><view wx:if="{{loading}}" class="empty">读取身份申请…</view><view wx:elif="{{!records.length && !error}}" class="empty">暂无身份审核记录</view><view wx:for="{{records}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="select"><view class="subtitle">{{item.profile.name}} · {{item.profile.identityType === 'teacher' ? '申请教师' : '申请学生'}}</view><view>学工号：{{item.profile.studentNo}}</view><view>电话：{{item.profile.phone}}</view><view class="muted">{{item.status === 'pending' ? '待审核 · 点击处理' : item.status === 'approved' ? '已通过' : '已拒绝'}}</view><view wx:if="{{item.reason}}">处理原因：{{item.reason}}</view></view><view wx:if="{{selected && selected.status === 'pending'}}" class="card"><view class="subtitle">处理：{{selected.profile.name}}</view><text class="label">拒绝原因（拒绝必填）</text><textarea bindinput="reason" value="{{reason}}" maxlength="500" /><view class="actions"><button class="danger" data-decision="reject" bindtap="review" disabled="{{busy}}">拒绝</button><button class="success" data-decision="approve" bindtap="review" disabled="{{busy}}">核验通过</button></view></view></view>
