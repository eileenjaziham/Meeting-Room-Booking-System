<view class="page">
  <view class="title">个人信息</view>
  <view class="muted page-description">查看当前登录账号的个人资料</view>
  <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">重新加载</view></view>
  <view wx:if="{{loading}}" class="empty">正在读取个人信息…</view>
  <view wx:elif="{{!user}}" class="card"><button class="primary" bindtap="login">登录后查看</button></view>
  <block wx:else>
    <view class="card info-card">
      <view class="avatar-row"><view><view>个人头像</view><view class="muted">点击头像更换</view></view><button class="info-avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{avatarBusy}}" aria-label="更换我的头像"><image class="info-avatar-image {{user.avatarUrl ? 'info-avatar-custom' : ''}}" src="{{user.avatarUrl || '/assets/icons/profile.svg'}}" mode="{{user.avatarUrl ? 'aspectFill' : 'aspectFit'}}" /></button></view>
      <view wx:if="{{avatarBusy}}" class="muted">正在保存头像…</view>
      <view class="kv"><text>姓名（不可修改）</text><text>{{profile.name || '未填写'}}</text></view>
      <view class="kv"><text>{{profile.identityType === 'teacher' ? '工号' : '学号'}}</text><text>{{profile.studentNo || '未填写'}}</text></view>
      <view class="kv"><text>身份类型</text><text>{{profile.identityType === 'teacher' ? '教师' : profile.identityType === 'student' ? '学生' : '未填写'}}{{user.verification !== 'approved' && profile.identityType ? '（申请中，尚未生效）' : ''}}</text></view>
      <view class="kv"><text>联系电话</text><text>{{profile.phone || '未填写'}}</text></view>
      <view class="kv"><text>核验状态</text><text class="{{user.verification === 'approved' ? 'verified' : 'pending'}}">{{statusText}}</text></view>
    </view>
    <view class="muted explanation">身份资料通过核验后生效。如资料有误，请通过反馈中心联系负责人核实。</view>
    <button class="secondary" bindtap="identity">身份认证与审核记录　›</button>
  </block>
</view>
