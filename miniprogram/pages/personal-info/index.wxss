.page-description{margin-bottom:26rpx}.info-card .kv{padding:23rpx 0;border-bottom:1rpx solid var(--ui-border)}.info-card .kv:last-child{border-bottom:0}.verified{color:#278c59}.pending{color:#ad7b2a}.explanation{margin:0 8rpx 28rpx}
.avatar-row{display:flex;justify-content:space-between;align-items:center;padding:4rpx 0 22rpx;border-bottom:1rpx solid var(--ui-border)}.info-avatar-button{width:104rpx;height:104rpx;border-radius:50%;overflow:hidden;padding:0;background:#e7f0f1;display:flex;align-items:center;justify-content:center}.info-avatar-image{width:60rpx;height:60rpx}.info-avatar-image.info-avatar-custom{width:100%;height:100%}
.info-avatar-button{min-width:104rpx;max-width:104rpx;flex:0 0 104rpx}.verified{color:var(--ui-success)}.pending{color:var(--ui-warning)}.explanation{line-height:1.8}
