.day.disabled{color:#c9d1db}.day.disabled text{background:transparent}.arrow.disabled{color:#dce2eb}.selected-day{border-top:1rpx solid var(--ui-border);padding-top:16rpx;margin-top:12rpx;color:var(--ui-primary);font-size:24rpx;display:flex;align-items:center;justify-content:space-between}.selected-day text{font-size:20rpx;color:var(--ui-text-muted)}.home-content .room-heading{white-space:normal;gap:22rpx}.home-content .room-number{font-size:40rpx;min-width:96rpx}.home-content .room-meta{font-size:23rpx;line-height:1.7}.home-content .room-meta view:last-child{color:var(--ui-text-muted);font-size:22rpx}.home-content .selected-date{font-size:21rpx}
