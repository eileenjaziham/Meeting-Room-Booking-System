.home-content{padding-left:24rpx;padding-right:24rpx;padding-bottom:40rpx}.quick-links{margin:0 16rpx 32rpx;padding:16rpx 8rpx;border:1rpx solid var(--ui-border);border-radius:32rpx;box-shadow:var(--ui-shadow-card);gap:8rpx}.calendar{border-radius:var(--ui-radius-card);border:1rpx solid var(--ui-border);padding:12rpx 20rpx 20rpx;box-shadow:var(--ui-shadow-card);margin-bottom:28rpx}.month-row{font-size:32rpx;color:var(--ui-text);min-height:80rpx}.arrow{width:88rpx;min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;color:var(--ui-text-muted)}.week{font-size:24rpx;color:var(--ui-text-muted);border-color:var(--ui-border)}.day{min-height:78rpx;font-size:27rpx}.day.selected text{background:var(--ui-primary)}.calendar-tools{font-size:24rpx;color:var(--ui-primary)}.calendar-tools text{min-height:44px;display:flex;align-items:center}.selected-day{color:var(--ui-primary);font-size:26rpx;gap:12rpx;flex-wrap:wrap}.selected-day text{color:var(--ui-text-muted);font-size:23rpx}.list-title{font-size:34rpx;gap:16rpx;margin:16rpx 0 22rpx;flex-wrap:wrap}.selected-date,.home-content .selected-date{font-size:23rpx;color:var(--ui-text-muted)}.footnote{font-size:24rpx;color:var(--ui-text-muted);line-height:1.7}.workbench-card{border:1rpx solid var(--ui-border);box-shadow:var(--ui-shadow-card);border-radius:var(--ui-radius-card)}.workbench-count,.workbench-scope,.workbench-total{color:var(--ui-text-muted);font-size:24rpx}.workbench-label{font-size:28rpx;color:var(--ui-text)}.workbench-row{min-height:112rpx}.workbench-pressed{background:var(--ui-field);opacity:1}.workbench-count.has-pending{background:var(--ui-warning-soft);color:var(--ui-warning)}
.day{min-height:44px}.calendar-tools text{min-width:44px}.room-pressed{opacity:1}@media(max-width:350px){.home-content{padding-left:10rpx;padding-right:10rpx}.calendar{padding-left:2rpx;padding-right:2rpx}.quick-links{margin-left:8rpx;margin-right:8rpx}.list-title{padding:0 12rpx}}
.day{position:relative}.booking-dot{width:9rpx;height:9rpx;min-width:5px;min-height:5px;flex-shrink:0;background:var(--ui-danger);border-radius:50%}.day .booking-dot{position:absolute;bottom:3rpx;left:50%;transform:translateX(-50%)}.calendar-legend{display:flex;align-items:center;justify-content:flex-end;gap:9rpx;color:var(--ui-text-muted);font-size:22rpx;margin:14rpx 0 0;line-height:1.6}.workbench-icon{position:relative}.reminder-dot{position:absolute;top:-3rpx;right:-3rpx;width:14rpx;height:14rpx;min-width:7px;min-height:7px;background:var(--ui-danger);border:3rpx solid #fff;border-radius:50%;box-sizing:content-box}
