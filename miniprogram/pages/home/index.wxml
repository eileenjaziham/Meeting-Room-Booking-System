<image class="campus" src="/assets/campus.png" mode="widthFix" aria-label="华中师范大学校徽、校名与校园建筑背景" />
<view style="height:{{statusHeight}}px"></view><view class="hero"></view>
<view class="home-content">
  <view class="quick-links"><view bindtap="bookings"><view class="quick-icon blue"><view class="calendar-icon"><view class="ring left"></view><view class="ring right"></view><view class="calendar-line"></view><view class="calendar-dots"></view></view></view><text>我的预约</text></view><view bindtap="notices"><view class="quick-icon yellow"><view class="calendar-icon"><view class="ring left"></view><view class="ring right"></view><view class="calendar-line"></view><view class="note-line"></view></view></view><text>预约须知</text></view><view bindtap="identity"><view class="quick-icon green"><view class="person-head"></view><view class="person-body"></view></view><text>身份信息</text></view></view>
  <view class="calendar"><view class="month-row"><text class="arrow {{canPrevMonth ? '' : 'disabled'}}" data-step="-1" bindtap="shiftMonth">‹</text><text>{{month}}月</text><text class="arrow {{canNextMonth ? '' : 'disabled'}}" data-step="1" bindtap="shiftMonth">›</text></view><view class="week"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="days"><view wx:for="{{days}}" wx:key="key" class="day {{item.selected ? 'selected' : ''}} {{item.today ? 'today' : ''}} {{item.disabled ? 'disabled' : ''}}" data-date="{{item.date}}" bindtap="selectDate"><text>{{item.day}}</text></view></view><view class="calendar-tools"><text bindtap="today">回到今天</text><text bindtap="toggleCalendar">{{expanded ? '收起月历 ⌃' : '展开月历 ⌄'}}</text></view><view class="selected-day">{{dateLabel}}<text>含今天可预约 7 天</text></view></view>
  <view class="list-title"><text>会议室列表</text><text class="selected-date">{{dateLabel}}</text></view>
  <mode-banner />
  <view wx:if="{{!user}}" class="card login-card"><view class="subtitle">欢迎使用会议室预约</view><view class="muted">登录并完成身份核验后查看日程</view><button class="primary" bindtap="login">进入登录</button></view>
  <view wx:elif="{{user.verification !== 'approved'}}" class="card login-card"><view>身份尚未通过核验</view><button class="primary" bindtap="identity">查看 / 提交身份信息</button></view>
  <view wx:if="{{error}}" class="error">{{error}}<view class="link" bindtap="load">点击重试</view></view>
  <view wx:if="{{loading}}" class="empty">正在加载数据库日程…</view>
  <view class="room-card" wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="openRoom" role="button"><view class="room-heading"><text class="room-number">{{item.number}}</text><view class="room-meta"><view>容量：{{item.capacity}} 人</view><view>设备：{{item.equipment}}</view></view><text class="chevron">›</text></view><schedule-bar occupied="{{item.occupied}}" /></view>
  <view wx:if="{{rooms.length}}" class="footnote">绿色空闲 · 红色占用 · 每日开放 08:00—22:00</view>
  <manager-contact />
</view>
