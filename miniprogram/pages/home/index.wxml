<image class="campus" src="/assets/campus-hd.png" mode="widthFix" aria-label="华中师范大学校徽、校名与校园建筑背景" />
<view style="height:{{statusHeight}}px"></view><view class="hero"></view>
<view class="home-content">
  <view wx:if="{{user.isAdmin}}" class="quick-links admin-quick-links"><quick-entry label="学生预约审核" icon="/assets/icons/calendar.svg" badge="{{adminStats.reservations > 0}}" bind:select="reviewBookings" /><quick-entry label="预约台账" icon="/assets/icons/notices.svg" tone="amber" bind:select="ledger" /><quick-entry label="会议室管理" icon="/assets/icons/admin.svg" tone="green" bind:select="manageRooms" /></view>
  <view wx:else class="quick-links"><quick-entry label="我的预约" icon="/assets/icons/calendar.svg" badge="{{unreadCount > 0}}" bind:select="bookings" /><quick-entry label="预约须知" icon="/assets/icons/notices.svg" tone="amber" bind:select="notices" /><quick-entry label="身份信息" icon="/assets/icons/profile.svg" tone="green" bind:select="identity" /></view>
  <view wx:if="{{user.isAdmin}}" class="admin-workbench">
    <view class="workbench-heading"><text class="workbench-title">工作台</text><text class="workbench-scope">全部五间会议室</text></view>
    <view wx:if="{{adminError}}" class="error">{{adminError}}<view class="link" bindtap="load">重新加载工作台</view></view>
    <view wx:elif="{{!adminStats}}" class="workbench-loading">正在读取管理待办…</view>
    <view wx:else class="workbench-card">
      <view class="workbench-row" bindtap="reviewUsers" role="button" aria-label="用户审核，{{adminStats.identities}}项待办" hover-class="workbench-pressed"><view class="workbench-icon"><image class="workbench-image" src="/assets/icons/profile.svg" mode="aspectFit" /><view wx:if="{{adminStats.identities}}" class="reminder-dot"></view></view><text class="workbench-label">用户审核</text><text class="workbench-count {{adminStats.identities ? 'has-pending' : ''}}">{{adminStats.identities}} 项待办</text><image class="workbench-arrow" src="/assets/icons/chevron.svg" mode="aspectFit" /></view>
      <view class="workbench-row" bindtap="reviewFeedback" role="button" aria-label="用户反馈，{{adminStats.feedback}}项待办" hover-class="workbench-pressed"><view class="workbench-icon"><image class="workbench-image" src="/assets/icons/feedback.svg" mode="aspectFit" /><view wx:if="{{adminStats.feedback}}" class="reminder-dot"></view></view><text class="workbench-label">用户反馈</text><text class="workbench-count {{adminStats.feedback ? 'has-pending' : ''}}">{{adminStats.feedback}} 项待办</text><image class="workbench-arrow" src="/assets/icons/chevron.svg" mode="aspectFit" /></view>
      <view class="workbench-total"><text>待审核预约 {{adminStats.reservations}} 项</text><text>预约记录共 {{adminStats.total}} 条</text></view>
    </view>
  </view>
  <block wx:if="{{!user.isAdmin}}">
  <view class="calendar"><view class="month-row"><text class="arrow {{canPrevMonth ? '' : 'disabled'}}" data-step="-1" bindtap="shiftMonth">‹</text><text>{{month}}月</text><text class="arrow {{canNextMonth ? '' : 'disabled'}}" data-step="1" bindtap="shiftMonth">›</text></view><view class="week"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="days"><view wx:for="{{days}}" wx:key="key" class="day {{item.selected ? 'selected' : ''}} {{item.today ? 'today' : ''}} {{item.disabled ? 'disabled' : ''}}" data-date="{{item.date}}" aria-label="{{item.date}}{{item.bookingCount ? '，本人有' + item.bookingCount + '条预约' : ''}}" bindtap="selectDate"><text>{{item.day}}</text><view wx:if="{{item.bookingCount}}" class="booking-dot" aria-hidden="true"></view></view></view><view class="calendar-legend"><view class="booking-dot"></view><text>本人有预约（待确认 / 已成功）</text></view><view class="calendar-tools"><text bindtap="today">回到今天</text><text bindtap="toggleCalendar">{{expanded ? '收起月历 ⌃' : '展开月历 ⌄'}}</text></view><view class="selected-day">{{dateLabel}}<text>含今天可预约 7 天</text></view></view>
  <view class="list-title"><text>会议室列表</text><text class="selected-date">{{dateLabel}}</text></view>
  <mode-banner />
  <view wx:if="{{!user}}" class="card login-card"><view class="subtitle">欢迎使用会议室预约</view><view class="muted">登录并完成身份核验后查看日程</view><button class="primary" bindtap="login">进入登录</button></view>
  <view wx:elif="{{user.verification !== 'approved'}}" class="card login-card"><view>身份尚未通过核验</view><button class="primary" bindtap="identity">查看 / 提交身份信息</button></view>
  <feedback-state wx:if="{{error}}" kind="error" title="暂时无法读取会议室日程" description="{{error}}" action-label="重新加载" bind:action="load" />
  <feedback-state wx:if="{{loading}}" kind="loading" title="正在读取会议室日程" />
  <feedback-state wx:if="{{!loading && !error && user.verification === 'approved' && !rooms.length}}" title="暂无会议室日程" description="请重新加载，或选择其他日期查看。" action-label="重新加载" bind:action="load" />
  <room-card wx:for="{{rooms}}" wx:key="id" room="{{item}}" bind:open="openRoom" />
  <view wx:if="{{rooms.length}}" class="footnote">绿色空闲 · 红色占用 · 每日开放 08:00—22:00</view>
  <manager-contact />
  </block>
  <mode-banner wx:if="{{user.isAdmin}}" />
</view>
