.quick-links.admin-quick-links{margin-bottom:28rpx}.quick-links.admin-quick-links>view{font-size:22rpx;flex:1;min-width:0}.admin-workbench{margin-bottom:28rpx}.workbench-heading{display:flex;align-items:center;justify-content:space-between;margin:0 4rpx 18rpx}.workbench-title{font-size:34rpx;font-weight:650;color:#202d43}.workbench-scope{font-size:21rpx;color:var(--ui-text-muted)}.workbench-card{background:#fff;border-radius:22rpx;padding:0 24rpx;box-shadow:0 5rpx 18rpx rgba(36,65,106,.055)}.workbench-row{display:flex;align-items:center;min-height:110rpx;border-bottom:1rpx solid var(--ui-border)}.workbench-icon{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;flex:0 0 62rpx;background:var(--ui-primary-soft);border-radius:17rpx;margin-right:18rpx}.workbench-image{width:36rpx;height:36rpx;display:block}.workbench-label{flex:1;min-width:0;font-size:27rpx;color:#33445e}.workbench-count{font-size:21rpx;color:var(--ui-text-muted);white-space:nowrap;margin-left:12rpx}.workbench-count.has-pending{color:#b27a29;background:#fff5e2;border-radius:9rpx;padding:3rpx 10rpx}.workbench-arrow{width:25rpx;height:25rpx;flex:0 0 25rpx;margin-left:8rpx}.workbench-total{display:flex;align-items:center;justify-content:space-between;padding:19rpx 0;color:var(--ui-text-muted);font-size:21rpx}.workbench-loading{background:#fff;border-radius:22rpx;padding:36rpx 24rpx;color:var(--ui-text-muted);text-align:center;font-size:24rpx}.workbench-pressed{opacity:.65}
