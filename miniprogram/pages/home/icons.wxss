.quick-icon{position:relative;display:flex;align-items:center;justify-content:center}.calendar-icon{width:62rpx;height:57rpx;border:4rpx solid currentColor;border-radius:4rpx;position:relative;margin-top:6rpx}.ring{position:absolute;top:-14rpx;width:4rpx;height:18rpx;background:currentColor;border-radius:3rpx}.ring.left{left:13rpx}.ring.right{right:13rpx}.calendar-line{position:absolute;left:0;right:0;top:13rpx;height:3rpx;background:currentColor}.calendar-dots{position:absolute;left:10rpx;top:25rpx;width:9rpx;height:6rpx;background:currentColor;box-shadow:20rpx 0 0 currentColor,0 12rpx 0 currentColor,20rpx 12rpx 0 currentColor}.note-line{position:absolute;left:10rpx;right:10rpx;top:28rpx;height:3rpx;background:currentColor;box-shadow:0 12rpx 0 currentColor}.person-head{position:absolute;top:18rpx;width:23rpx;height:23rpx;border:3rpx solid currentColor;border-radius:50%}.person-body{position:absolute;bottom:18rpx;width:49rpx;height:24rpx;border:3rpx solid currentColor;border-radius:22rpx 22rpx 3rpx 3rpx}
