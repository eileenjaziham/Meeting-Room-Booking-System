or:#141b27}.room-meta{font-size:23rpx;flex:1;color:#343b45}.chevron{color:#999;font-size:45rpx;line-height:1}.footnote{text-align:center;font-size:21rpx;color:#6c829f;margin-top:24rpx}.login-card{margin-top:24rpx}.login-card button{margin-top:22rpx}
