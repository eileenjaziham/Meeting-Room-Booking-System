<mode-banner />
<view class="login-screen">
 <image class="login-background" src="/assets/campus-hd.png" mode="widthFix" aria-label="华中师范大学校徽、校名与校园背景" />
 <view class="login-content">
  <view class="login-title">计算机学院预约系统</view><view class="login-subtitle">一站式登录</view>
  <view class="login-actions"><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary login-submit" bindtap="login" disabled="{{opening}}" loading="{{opening}}">进入统一身份认证</button></view>
  <view class="login-info"><view class="login-info-title">说明</view><view>本系统仅供华中师范大学计算机学院师生使用。</view><view class="login-info-detail">一站式平台暂未接入，点击登录后选择现有演示账号。</view></view>
 </view>
</view>
