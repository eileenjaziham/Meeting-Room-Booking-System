<mode-banner />
<view class="login-brand"><image class="login-brand-image" src="/assets/campus.png" mode="widthFix" /></view>
<view class="page login-page"><view class="title">欢迎登录</view><view class="login-subtitle">计算机学院会议室预约</view>
  <view class="card"><view class="subtitle">{{local ? '选择测试身份登录' : '微信会话登录'}}</view>
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <view wx:if="{{local}}" class="stack"><button wx:for="{{accounts}}" wx:key="id" class="secondary account" data-account="{{item.id}}" bindtap="login" disabled="{{busy}}"><view>{{item.label}}</view><view class="small">{{item.type}}</view></button></view>
    <button wx:else class="primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">登录并进入身份核验</button>
    <view class="muted login-privacy">学校统一身份认证尚未授权接入，当前使用隔离测试身份演示；本小程序不收集校园密码。</view>
  </view>
</view>
