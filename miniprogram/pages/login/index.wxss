.login-screen{position:relative;min-height:calc(100vh - 40rpx);padding:0 40rpx 48rpx;padding-bottom:calc(48rpx + env(safe-area-inset-bottom));overflow:hidden}.login-background{position:absolute;top:0;left:0;width:100%;pointer-events:none}.login-content{position:relative;padding-top:330rpx}.login-title{text-align:center;color:var(--ui-text);font-size:42rpx;font-weight:650;letter-spacing:2rpx;line-height:1.5;overflow-wrap:anywhere}.login-subtitle{text-align:center;color:var(--ui-text-muted);font-size:27rpx;line-height:1.7;margin-top:12rpx}.login-actions{margin-top:132rpx}.login-screen .login-content button.login-submit{width:100%;min-height:96rpx;min-height:max(96rpx,44px);font-size:31rpx;font-weight:600;border-radius:20rpx;padding:24rpx}.login-demo-note{color:var(--ui-text-muted);font-size:24rpx;text-align:center;line-height:1.7;margin:18rpx 8rpx 0}.login-info{background:rgba(255,255,255,.95);border:1rpx solid var(--ui-border);border-radius:var(--ui-radius-card);padding:28rpx;margin-top:64rpx;color:var(--ui-text);font-size:26rpx;line-height:1.8;box-shadow:var(--ui-shadow-card)}.login-info-title{font-weight:600;margin-bottom:10rpx}.login-info-detail{font-size:24rpx;color:var(--ui-text-muted);margin-top:10rpx}@media(max-width:350px){.login-screen{padding-left:30rpx;padding-right:30rpx}.login-title{font-size:39rpx;letter-spacing:0}.login-actions{margin-top:100rpx}.login-info{padding:24rpx;margin-top:48rpx}}
