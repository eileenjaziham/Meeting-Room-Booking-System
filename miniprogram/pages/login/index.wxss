.login-brand{height:250rpx;overflow:hidden}.login-brand-image{width:100%;display:block}.login-page{padding-top:8rpx}.login-subtitle{font-size:25rpx;color:#7188a8;margin:0 0 24rpx}.account{width:100%;text-align:left;padding:18rpx 24rpx}.account .small{font-size:22rpx;color:#7894bd}.account+.account{margin-top:14rpx}.login-privacy{font-size:22rpx;line-height:1.8;margin-top:24rpx}
.login-subtitle,.account .small,.login-privacy{color:var(--ui-text-muted);font-size:24rpx}.account{border:1rpx solid var(--ui-border);border-radius:var(--ui-radius-control);min-height:44px;line-height:1.6}.account:active{background:var(--ui-primary-pressed)}
