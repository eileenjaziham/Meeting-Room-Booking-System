:host{display:block;min-width:0}.field{margin:0 0 28rpx}.field-label{display:block;font-size:26rpx;line-height:1.5;color:var(--ui-text,#24364b);font-weight:500;margin-bottom:12rpx}.required{color:var(--ui-danger,#b42337)}.control{box-sizing:border-box;border:1rpx solid var(--ui-border,#dfe7f2);border-radius:var(--ui-radius-control,16rpx);background:var(--ui-field,#f6f8fc);transition:border-color var(--ui-motion-fast,120ms),box-shadow var(--ui-motion-fast,120ms);overflow:hidden}.field-input{box-sizing:border-box;display:block;width:100%;height:96rpx;min-height:44px;padding:20rpx 22rpx;color:var(--ui-text,#24364b);font-size:30rpx;line-height:1.5;background:transparent;border:0}.field-textarea{height:auto;min-height:176rpx;padding-top:22rpx;padding-bottom:22rpx}.field-placeholder{color:var(--ui-text-muted,#52647a);font-size:28rpx}.is-focused{border-color:#a9b8bb;box-shadow:0 0 0 4rpx rgba(86,108,113,.1);background:#fff}.is-error{border-color:var(--ui-danger,#b42337);background:#fff9fa}.is-disabled{background:var(--ui-disabled,#e8edf4)}.field-error,.field-helper{font-size:24rpx;line-height:1.6;margin-top:10rpx;overflow-wrap:anywhere}.field-error{color:var(--ui-danger,#b42337)}.field-helper{color:var(--ui-text-muted,#52647a)}.stepper{display:flex;align-items:center;background:#fff}.stepper .field-input{flex:1;min-width:0;text-align:center;padding-left:8rpx;padding-right:8rpx}.step-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:96rpx;height:96rpx;min-width:44px;min-height:44px;flex-shrink:0;margin:0;padding:0;background:#f6f8fc;border:0;border-radius:0}.step-button::after{border:0}.step-button[disabled]{opacity:.4}.step-icon{width:34rpx;height:34rpx}.step-pressed{background:#e9eef0}@media(prefers-reduced-motion:reduce){.control{transition:none}}
:host .stepper .field-input{width:0;flex:1 1 0;min-width:0}.stepper .step-button{flex:0 0 auto;width:88rpx;min-width:44px;min-height:44px}.step-disabled{opacity:.35}
