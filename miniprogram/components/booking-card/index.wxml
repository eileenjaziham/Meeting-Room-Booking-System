<view class="record" bindtap="open" role="button" hover-class="record-pressed" hover-start-time="0"><view class="top"><text class="room">{{record.roomId}} 会议室</text><status-tag status="{{record.status}}" label="{{record.statusText}}" /></view><view class="record-time">{{record.date}}　{{record.start}}—{{record.end}}</view><view class="muted">{{record.purpose}} · {{record.attendees}} 人</view><view wx:if="{{record.borrowerName}}" class="muted">借用人：{{record.borrowerName}} · 负责老师：{{record.responsibleTeacher}}</view><view wx:if="{{record.reason}}" class="reason">处理说明：{{record.reason}}</view></view>
