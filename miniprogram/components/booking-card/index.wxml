<view class="record" bindtap="open" role="button"><view class="top"><text class="room">{{record.roomId}} 会议室</text><text class="status {{record.status}}">{{record.statusText}}</text></view><view>{{record.date}}　{{record.start}}—{{record.end}}</view><view class="muted">{{record.purpose}} · {{record.attendees}} 人</view><view wx:if="{{record.reason}}" class="reason">处理说明：{{record.reason}}</view></view>
