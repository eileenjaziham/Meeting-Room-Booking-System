.record{background:#fff;border-radius:20rpx;padding:26rpx;margin-bottom:20rpx;color:#26354b;font-size:26rpx;box-shadow:0 5rpx 18rpx #2a4b710a}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx}.room{font-size:31rpx;font-weight:600}.status{font-size:23rpx;color:#6e7e96;background:#f0f3f8;padding:4rpx 12rpx;border-radius:8rpx}.pending{color:#a46c06;background:#fff3d8}.approved{color:#23894b;background:#e4f6e9}.muted{color:#7d8a9e;font-size:24rpx;margin-top:10rpx}.reason{font-size:24rpx;color:#ad7050;margin-top:12rpx}
