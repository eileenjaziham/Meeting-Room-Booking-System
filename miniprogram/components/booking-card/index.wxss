.record{background:#fff;border-radius:20rpx;padding:26rpx;margin-bottom:20rpx;color:#24364b;font-size:26rpx;box-shadow:0 5rpx 18rpx #2a4b710a}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx}.room{font-size:31rpx;font-weight:600}.status{font-size:23rpx;color:#6e7e96;background:#f0f3f8;padding:4rpx 12rpx;border-radius:8rpx}.pending{color:#a46c06;background:#fff3d8}.approved{color:#23894b;background:#e4f6e9}.muted{color:#77859b;font-size:24rpx;margin-top:10rpx}.reason{font-size:24rpx;color:#ad7050;margin-top:12rpx}
.record{border:1rpx solid var(--ui-border,#dfe7f2);border-radius:var(--ui-radius-card,24rpx);box-shadow:var(--ui-shadow-card);padding:26rpx;color:var(--ui-text,#24364b)}.top{gap:16rpx;flex-wrap:wrap}.room{font-size:32rpx}.record-time{font-size:27rpx;line-height:1.7;font-variant-numeric:tabular-nums}.muted{color:var(--ui-text-muted,#52647a);overflow-wrap:anywhere;word-break:normal;line-height:1.7}.reason{border-radius:12rpx;padding:16rpx;background:var(--ui-neutral-soft,#eef2f6);color:var(--ui-text-muted,#52647a);line-height:1.7;overflow-wrap:anywhere}.record-pressed{background:#f8faff}
