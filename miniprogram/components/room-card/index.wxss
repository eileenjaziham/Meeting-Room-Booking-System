:host{display:block;min-width:0}.room-card{box-sizing:border-box;padding:24rpx;margin:0 0 20rpx;border:1rpx solid var(--ui-border,#dfe7f2);border-radius:var(--ui-radius-card,24rpx);background:var(--ui-surface,#fff);box-shadow:var(--ui-shadow-card,0 6rpx 22rpx rgba(36,65,106,.055));transition:background-color var(--ui-motion-fast,120ms)}.room-main{display:flex;align-items:center;min-width:0}.room-thumb{display:block;width:116rpx;height:112rpx;flex:0 0 116rpx;object-fit:cover;border-radius:16rpx;background:var(--ui-neutral-soft,#eef2f6);margin-right:20rpx}.room-content{flex:1;min-width:0}.room-heading{display:flex;align-items:baseline;flex-wrap:wrap;gap:8rpx;line-height:1.35}.room-number{font-size:36rpx;font-weight:650;color:var(--ui-text,#24364b)}.room-unit{font-size:24rpx;color:var(--ui-text-muted,#52647a)}.room-meta,.room-equipment{font-size:24rpx;color:var(--ui-text-muted,#52647a);line-height:1.6;overflow-wrap:anywhere}.room-meta{margin-top:8rpx}.room-arrow{width:28rpx;height:28rpx;flex:0 0 28rpx;margin-left:12rpx}.room-schedule{margin-top:20rpx;border-top:1rpx solid var(--ui-border,#dfe7f2);padding-top:16rpx}.room-state{display:inline-block;font-size:22rpx;line-height:1.5;color:var(--ui-text-muted,#52647a)}.room-state.free{color:var(--ui-success,#167348)}.room-state.occupied{color:var(--ui-warning,#965b12)}.room-pressed{background:#f8faff}@media(prefers-reduced-motion:reduce){.room-card{transition:none}}
