:host{display:block;min-width:0}.field-label{display:block;font-size:26rpx;font-weight:500;color:var(--ui-text,#24364b);line-height:1.5;margin-bottom:12rpx}.field-note{font-size:24rpx;font-weight:400;margin-left:10rpx;color:var(--ui-text-muted,#52647a)}.date-control,.time-control{display:flex;align-items:center;box-sizing:border-box;width:100%;min-width:0;min-height:44px;border:1rpx solid var(--ui-border,#dfe7f2);border-radius:16rpx;background:var(--ui-field,#f6f8fc);padding:22rpx 18rpx;gap:12rpx}.control-icon{width:32rpx;height:32rpx;flex:0 0 32rpx;display:block}.chevron{width:22rpx;height:22rpx;flex:0 0 22rpx;display:block}.date-value{font-size:28rpx;color:var(--ui-text,#24364b);line-height:1.5;flex:1;min-width:0}.schedule{margin-top:8rpx}.hint{font-size:24rpx;line-height:1.65;color:var(--ui-text-muted,#52647a);padding:16rpx 18rpx;margin-top:20rpx;border-radius:12rpx;background:var(--ui-primary-soft,#edf3ff)}.time-grid{display:flex;gap:16rpx;margin:26rpx 0 18rpx}.time-cell{flex:1;min-width:0}.time-control{padding:22rpx 12rpx;gap:8rpx;background:#fff;border-color:#c9d9f4}.time-value{font-size:34rpx;line-height:1.4;color:var(--ui-primary,#2563eb);font-weight:600;flex:1;min-width:0;font-variant-numeric:tabular-nums}.helper,.no-time{font-size:24rpx;color:var(--ui-text-muted,#52647a);line-height:1.7}.no-time{padding:26rpx 12rpx;text-align:center}.disabled{background:var(--ui-disabled,#e8edf4);opacity:.65}@media(max-width:350px){.time-control .control-icon{display:none}.time-value{font-size:32rpx}.date-control{padding-left:14rpx;padding-right:14rpx}}
