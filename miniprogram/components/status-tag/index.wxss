:host{display:inline-block;max-width:100%}.tag{display:inline-block;box-sizing:border-box;font-size:24rpx;line-height:1.5;padding:4rpx 12rpx;border-radius:9rpx;color:var(--ui-neutral,#59687b);background:var(--ui-neutral-soft,#eef2f6);white-space:normal;overflow-wrap:anywhere}.pending{color:var(--ui-warning,#965b12);background:var(--ui-warning-soft,#fff4dd)}.approved{color:var(--ui-success,#167348);background:var(--ui-success-soft,#eaf7ef)}.rejected{color:var(--ui-danger,#b42337);background:var(--ui-danger-soft,#fff0f2)}
