.contact-card{background:#f0f5ff;border:1rpx solid #dce7fa;border-radius:18rpx;padding:24rpx;margin:24rpx 0;color:#536d96}.contact-title{font-size:26rpx;font-weight:600;color:#3e639c}.contact-note{font-size:23rpx;line-height:1.7;margin-top:8rpx}.contact-row{display:flex;align-items:center;justify-content:space-between;gap:10rpx;font-size:23rpx;margin-top:16rpx}.copy{flex-shrink:0;color:#3478ff;padding:7rpx 14rpx;border-radius:10rpx;background:white}
