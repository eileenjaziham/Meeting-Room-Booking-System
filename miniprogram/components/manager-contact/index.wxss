.contact-card{background:#f0f5ff;border:1rpx solid #dce7fa;border-radius:18rpx;padding:24rpx;margin:24rpx 0;color:#536d96}.contact-title{font-size:26rpx;font-weight:600;color:#3e639c}.contact-note{font-size:23rpx;line-height:1.7;margin-top:8rpx}.contact-row{display:flex;align-items:center;justify-content:space-between;gap:10rpx;font-size:23rpx;margin-top:16rpx}.copy{flex-shrink:0;color:#3478ff;padding:7rpx 14rpx;border-radius:10rpx;background:white}
.contact-card{background:var(--ui-primary-soft,#edf3ff);border-color:var(--ui-border,#dfe7f2);border-radius:var(--ui-radius-card,24rpx);color:var(--ui-text-muted,#52647a)}.contact-title{color:var(--ui-text,#24364b);font-size:27rpx}.contact-note,.contact-row{font-size:24rpx}.contact-row{flex-wrap:wrap;gap:16rpx}.copy{min-height:44px;min-width:44px;display:flex;align-items:center;justify-content:center;padding:12rpx 20rpx;color:var(--ui-primary,#2563eb);border:1rpx solid var(--ui-border,#dfe7f2);border-radius:14rpx}
