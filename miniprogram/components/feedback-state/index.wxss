:host{display:block}.state{box-sizing:border-box;background:var(--ui-surface,#fff);border:1rpx solid var(--ui-border,#dfe7f2);border-radius:var(--ui-radius-card,24rpx);padding:32rpx 24rpx;margin-bottom:24rpx;text-align:center}.state-icon{width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;margin:0 auto 20rpx;background:var(--ui-primary-soft,#e7f0f1)}.state-image{width:44rpx;height:44rpx}.state-title{font-size:30rpx;line-height:1.5;font-weight:500;color:var(--ui-text,#24364b);overflow-wrap:anywhere}.state-description{font-size:24rpx;line-height:1.7;color:var(--ui-text-muted,#52647a);margin-top:10rpx;overflow-wrap:anywhere}.error .state-icon{background:var(--ui-danger-soft,#fff0f2)}.success .state-icon{background:var(--ui-success-soft,#eaf7ef)}.state-action{box-sizing:border-box;margin:24rpx auto 0;padding:16rpx 28rpx;min-height:44px;background:var(--ui-primary-soft,#e7f0f1);color:var(--ui-primary,#407785);font-size:26rpx;line-height:1.5;border-radius:16rpx}.state-action::after{border:0}.state-action-pressed{background:var(--ui-primary-pressed,#d7e6e8)}.skeleton{display:flex;align-items:center;padding:22rpx 0;border-bottom:1rpx solid var(--ui-border,#dfe7f2)}.skeleton-square{width:96rpx;height:88rpx;flex:0 0 96rpx;border-radius:14rpx;background:var(--ui-neutral-soft,#eef2f6)}.skeleton-copy{flex:1;min-width:0;padding-left:24rpx}.skeleton-line{height:22rpx;border-radius:8rpx;background:var(--ui-neutral-soft,#eef2f6);margin:12rpx 0;width:85%}.skeleton-line.short{width:55%}
