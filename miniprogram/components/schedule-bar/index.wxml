<view class="timeline" aria-label="绿色空闲，红色占用；红色起止位置上方标注时间">
  <view class="edge-labels" style="height:{{labelHeight}}rpx"><text wx:for="{{labels}}" wx:key="time" class="edge-label" style="left:{{item.left}}%;top:{{item.top}}rpx;transform:translateX({{item.shift}})">{{item.time}}</text></view>
  <view class="bar"><view wx:if="{{selected}}" class="selected-period" style="left:{{selected.left}}%;width:{{selected.width}}%"></view><view wx:for="{{segments}}" wx:key="start" class="occupied" style="left:{{item.left}}%;width:{{item.width}}%"></view></view>
</view>
<view class="ticks"><text class="tick" style="left:0;transform:none">08:00</text><text class="tick" style="left:28.5714%">12:00</text><text class="tick" style="left:57.1429%">16:00</text><text class="tick" style="left:100%;transform:translateX(-100%)">22:00</text></view>
<view wx:if="{{detail}}" class="legend"><text class="green">● 空闲</text><text class="red">● 占用 / 停用</text><text wx:if="{{selected}}" class="selected-legend">● 当前选择</text></view>
<view wx:if="{{detail && !occupied.length}}" class="periods">当日暂无占用，提交时仍会再次校验</view>
