.bar{height:12rpx;position:relative;background:#31c928;border-radius:10rpx;overflow:hidden;margin-top:20rpx}.occupied{position:absolute;top:0;height:100%;background:#df392d}.ticks{display:flex;justify-content:space-between;font-size:18rpx;color:#596574;margin-top:6rpx}.legend{display:flex;flex-wrap:wrap;gap:18rpx;font-size:23rpx;color:#8490a1;margin-top:20rpx}.green{color:#299d36}.red{color:#d7463b}.periods{font-size:24rpx;color:#77859b;margin-top:14rpx}
