.timeline{margin-top:20rpx}.edge-labels{position:relative}.edge-label{position:absolute;color:#bf382f;font-size:18rpx;line-height:24rpx;white-space:nowrap}.bar{height:12rpx;position:relative;background:#31c928;border-radius:10rpx;overflow:hidden}.occupied{position:absolute;top:0;height:12rpx;background:#df392d}.ticks{position:relative;height:24rpx;font-size:18rpx;color:#596574;margin-top:6rpx}.tick{position:absolute;transform:translateX(-50%);white-space:nowrap}.legend{display:flex;flex-wrap:wrap;gap:18rpx;font-size:23rpx;color:#8490a1;margin-top:20rpx}.green{color:#299d36}.red{color:#d7463b}.periods{font-size:24rpx;color:#77859b;margin-top:14rpx}
.selected-period{position:absolute;top:0;height:12rpx;background:var(--ui-primary,#2563eb)}.selected-legend{color:var(--ui-primary,#2563eb)}.legend{font-size:24rpx;line-height:1.6;gap:16rpx}.green{color:var(--ui-success,#167348)}.red{color:var(--ui-danger,#b42337)}.periods{color:var(--ui-text-muted,#52647a)}
