:host{display:block;flex:1;min-width:0}.entry{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:132rpx;min-width:44px;padding:12rpx 4rpx;border-radius:18rpx;transition:background-color var(--ui-motion-fast,120ms)}.icon-box{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;background:var(--ui-primary-soft,#e7f0f1);margin-bottom:12rpx}.icon-box.amber{background:#fff5df}.icon-box.green{background:var(--ui-success-soft,#eaf7ef)}.entry-icon{display:block;width:46rpx;height:46rpx}.entry-label{font-size:25rpx;line-height:1.5;color:var(--ui-text,#24364b);text-align:center;font-weight:500;word-break:normal}.entry-pressed{background:var(--ui-primary-soft,#e7f0f1)}@media(prefers-reduced-motion:reduce){.entry{transition:none}}
.icon-box{position:relative}.reminder-dot{position:absolute;top:-3rpx;right:-3rpx;width:16rpx;height:16rpx;min-width:8px;min-height:8px;border:3rpx solid #fff;border-radius:50%;background:var(--ui-danger,#b42337);box-sizing:content-box}
