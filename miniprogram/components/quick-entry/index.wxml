<view class="entry" bindtap="select" role="button" aria-label="{{label}}{{badge ? '，有未读消息或待办' : ''}}" hover-class="entry-pressed" hover-start-time="0" hover-stay-time="100"><view class="icon-box {{tone}}"><image class="entry-icon" src="{{icon}}" mode="aspectFit" aria-hidden="true" /><view wx:if="{{badge}}" class="reminder-dot" aria-hidden="true"></view></view><text class="entry-label">{{label}}</text></view>
