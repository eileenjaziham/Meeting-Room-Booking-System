# 本地默认使用 MySQL 8；先运行 npm run db:init 建库建表并写入会议室与演示账号（可重复执行）
DB_DRIVER=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_DATABASE=meeting_room_booking
MYSQL_POOL_SIZE=5
HOST=127.0.0.1
PORT=3000
ENABLE_DEV_LOGIN=true
# 可选：也可以使用完整连接地址，优先级高于上面的分项配置
# MYSQL_URL=mysql://root:1234@localhost:3306/meeting_room_booking
# 旧的本地嵌入式数据库配置（需要时手动切回）
# DB_DRIVER=pglite
# LOCAL_DB_PATH=./data/local
# pg 模式改为 DB_DRIVER=pg，并填写服务端连接字符串，禁止提交真实值
# DATABASE_URL=postgresql://user:password@host:5432/rooms
# PG_SSL=true
# PG_CA_FILE=./certs/ca.pem
# 云环境必须禁用开发登录，使用 wx-server-sdk 的可信 OPENID
