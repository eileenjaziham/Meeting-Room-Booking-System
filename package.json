{
  "name": "ccnu-room-reservation",
  "version": "1.0.0",
  "private": true,
  "description": "华中师范大学计算机学院会议室预约微信小程序（课程演示）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-dev.js",
    "start:lan": "node --env-file-if-exists=.env --env-file-if-exists=.env.lan scripts/start-dev.js --lan",
    "smoke": "node scripts/smoke.js",
    "version:sync": "node scripts/sync-version.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check.js && node scripts/compile-mini.js",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.js",
    "db:sql": "node scripts/db-sql.js",
    "db:migrate:mysql": "node --env-file-if-exists=.env scripts/migrate-pglite-to-mysql.js",
    "db:normalize:mysql": "node --env-file-if-exists=.env scripts/normalize-mysql.js",
    "cloud:prepare": "node scripts/prepare-cloud.js",
    "spec:validate": "openspec validate --all --strict",
    "test:postgres": "node --env-file-if-exists=.env --test tests-postgres/*.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "mysql2": "^3.15.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^2.0.0",
    "fzstd": "^0.1.1",
    "jsdom": "^29.1.1",
    "miniprogram-compiler": "^0.2.3",
    "miniprogram-simulate": "^1.7.0"
  }
}
